# Copy this file to .env for local development.
# All PUBLIC_-prefixed vars are exposed to client-side code by Astro.

# Optional: third-party form backend endpoint for the contact form
# (e.g. https://formspree.io/f/xxxxxxx). Leave blank to use a mailto: fallback.
PUBLIC_CONTACT_FORM_ENDPOINT=

# Optional: analytics site ID (e.g. Plausible, GA4). Leave blank to disable.
PUBLIC_ANALYTICS_ID=
