---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlaceholderNote from "../components/PlaceholderNote.astro";
import { SITE, CONTACT_FORM_ENDPOINT } from "../data/site";
---

<BaseLayout title="Contact">
  <section class="section container">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch</h1>
    <p class="lede">TODO: replace with a real intro sentence for this page.</p>

    {
      CONTACT_FORM_ENDPOINT ? (
        <form class="contact-form card" action={CONTACT_FORM_ENDPOINT} method="POST">
          <label>
            Name
            <input type="text" name="name" required />
          </label>
          <label>
            Email
            <input type="email" name="email" required />
          </label>
          <label>
            Message
            <textarea name="message" rows="5" required />
          </label>
          <button class="btn btn-primary" type="submit">
            Send message
          </button>
        </form>
      ) : (
        <div class="card">
          <p>
            No form backend is configured yet (see{" "}
            <code>PUBLIC_CONTACT_FORM_ENDPOINT</code> in <code>.env.example</code>
            ). For now, reach out directly:
          </p>
          <p>
            <a class="btn btn-primary" href={`mailto:${SITE.contactEmail}`}>
              Email {SITE.contactEmail}
            </a>
          </p>
          <PlaceholderNote text="Wire up a form backend (Formspree, Azure Function, etc.) before launch" />
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 480px;
  }

  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .contact-form input,
  .contact-form textarea {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
  }

  .contact-form button {
    align-self: flex-start;
  }
</style>
