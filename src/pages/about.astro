---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../data/site";
---

<BaseLayout title="About">
  <section class="section container">
    <p class="eyebrow">About</p>
    <h1>About AI School of London</h1>
    <p class="lede">
      AI School of London is headquartered in London and is the training and
      certification arm of Orchya Tech Limited. We conduct corporate
      training and run AI & ML training courses, with Data Analytics taught
      to newcomers entering the data science space.
    </p>

    <div class="grid grid-2" style="margin-top: 3rem;">
      <div class="card">
        <h3>What We Do</h3>
        <p>
          Corporate training and AI &amp; ML training courses. Data Analytics
          is taught specifically for newcomers entering the data science
          space.
        </p>
      </div>
      <div class="card">
        <h3>Specialised Courses</h3>
        <p>
          Data Science, Data Engineering, Cloud Engineering, Quantum
          Computing, Robotics, and Physical AI.
        </p>
      </div>
      <div class="card">
        <h3>Headquarters</h3>
        <p>
          London, United Kingdom — the training and certification arm of{" "}
          <a href="https://www.orchya.co.uk/" target="_blank" rel="noopener noreferrer">
            Orchya Tech Limited
          </a>.
        </p>
      </div>
      <div class="card">
        <h3>Get in touch</h3>
        <p>
          Reach out at <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
          or via the <a href="/contact/">contact page</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
