---
interface Props {
  title: string;
  lede?: string;
  cta: { label: string; href: string };
}
const { title, lede, cta } = Astro.props;
---

<section class="cta section section-alt">
  <div class="container cta-inner">
    <div>
      <h2>{title}</h2>
      {lede && <p class="lede">{lede}</p>}
    </div>
    <a class="btn btn-primary" href={cta.href}>{cta.label}</a>
  </div>
</section>

<style>
  .cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
</style>
